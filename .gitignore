# Cached historical OHLCV from Binance dump (re-downloadable, ~30 MB)
bot/data/historical/

# Personal/paid data sources — never commit
# (bitcoinstrategyplatform.com export, Glassnode CSVs, etc.)
bot/data/private/
docs/*cookies*
docs/*roots*
docs/*bitcoinstrategyplatform*
docs/*.har
docs/*.csv
docs/bitcoin_hodl_strategy_plan.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# Environment — block every .env variant; only allow explicit example files
.env
.env.*
!.env.example
!.env.*.example

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Node (dashboard)
node_modules/
.next/

# Docker
pgdata/

# Database and Redis dumps. A plaintext copy holds trades, positions and
# equity, the session secret and every tenant's encrypted keys; the secret
# patterns in .githooks/pre-commit do not recognise a dump. *.sql covers a
# plain-format pg_dump. If a tracked .sql is ever needed, un-ignore that one
# path with !path/file.sql.
*.dump
*.rdb
*.sql

# Local agent / secrets-manager session caches — NEVER commit
# (.claude/settings.json and .claude/hooks/ are the shared, checked-in
# project config; everything else under .claude/ stays local)
.claude/*
!.claude/settings.json
!.claude/hooks/
.phase.json
